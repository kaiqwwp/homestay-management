<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="room_types" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="title" class="java.lang.String"/>

    <field name="id" class="java.lang.Long"/>
    <field name="name" class="java.lang.String"/>
    <field name="pricePerNight" class="java.math.BigDecimal"/>
    <field name="capacity" class="java.lang.Integer"/>
    <field name="description" class="java.lang.String"/>

    <title>
        <band height="50">
            <textField>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font fontName="Roboto" size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{title}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="40" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Roboto" isBold="true"/></textElement>
                <text><![CDATA[STT]]></text>
            </staticText>
            <staticText>
                <reportElement x="40" y="0" width="140" height="25"/>
                <textElement verticalAlignment="Middle"><font fontName="Roboto" isBold="true"/></textElement>
                <text><![CDATA[Loại phòng]]></text>
            </staticText>
            <staticText>
                <reportElement x="180" y="0" width="100" height="25"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Roboto" isBold="true"/></textElement>
                <text><![CDATA[Giá/đêm (đ)]]></text>
            </staticText>
            <staticText>
                <reportElement x="280" y="0" width="60" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Roboto" isBold="true"/></textElement>
                <text><![CDATA[Sức chứa]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="0" width="215" height="25"/>
                <textElement verticalAlignment="Middle"><font fontName="Roboto" isBold="true"/></textElement>
                <text><![CDATA[Mô tả]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField>
                <reportElement x="0" y="0" width="40" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Roboto"/></textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="40" y="0" width="140" height="22"/>
                <textElement verticalAlignment="Middle"><font fontName="Roboto"/></textElement>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement x="180" y="0" width="100" height="22"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Roboto"/></textElement>
                <textFieldExpression><![CDATA[$F{pricePerNight}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="0" width="60" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Roboto"/></textElement>
                <textFieldExpression><![CDATA[$F{capacity}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="340" y="0" width="215" height="22"/>
                <textElement verticalAlignment="Middle"><font fontName="Roboto"/></textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>